{
  "manifest_version": 3,
  "name": "CRD Multi-Monitor",
  "version": "1.2.0",
  "description": "Tách các màn hình của máy từ xa trong Chrome Remote Desktop ra nhiều cửa sổ, mỗi cửa sổ một màn hình cục bộ.",
  "permissions": ["storage", "system.display"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "CRD Multi-Monitor: hiện/ẩn bảng điều khiển",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "commands": {
    "toggle-panel": {
      "suggested_key": { "default": "Alt+Shift+M" },
      "description": "Hiện/ẩn bảng điều khiển Multi-Monitor"
    },
    "toggle-window-fullscreen": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "Bật/tắt toàn màn hình cho cửa sổ tab CRD"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://remotedesktop.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
